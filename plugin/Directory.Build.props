<Project>
  <PropertyGroup>
    <JellyfinLine Condition="'$(JellyfinLine)' == ''">10.11</JellyfinLine>
    <TargetFramework Condition="'$(JellyfinLine)' == '10.11'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinLine)' == '12'">net10.0</TargetFramework>
    <JellyfinVersion Condition="'$(JellyfinLine)' == '10.11'">10.11.11</JellyfinVersion>
    <JellyfinVersion Condition="'$(JellyfinLine)' == '12'">12.0.0-rc5</JellyfinVersion>
    <DefineConstants Condition="'$(JellyfinLine)' == '10.11'">$(DefineConstants);JELLYFIN_10_11</DefineConstants>
    <DefineConstants Condition="'$(JellyfinLine)' == '12'">$(DefineConstants);JELLYFIN_12</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
