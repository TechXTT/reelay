      "name": "www.UIndex.org    -    the.legend.of.aang.the.last.airbender.2026.1080p.web-dl.aac2.0.h264-ngp",
      "expect": {
        "title": "the legend of aang the last airbender",
        "year": 2026,
        "resolution": "1080p",
        "source": "webdl",
        "video_codec": "x264",
        "release_group": "ngp"
      },
      "note": "real name from the user's NAS"
    },
    {
      "name": "From.S04E08.1080p.WEB.h264-ETHEL[EZTVx.to].mkv",
      "expect": {
        "title": "from",
        "season": 4,
        "episodes": [8],
        "release_group": "ETHEL",
        "container": ".mkv"
      },
      "note": "real name from the user's NAS; the site tag sits between the group and the extension"
    },
    {
      "name": "Show Name S01E01 1080p WEB h264-GROUP[TGx]",
      "expect": {
        "release_group": "GROUP"
      }
    },
    {
      "name": "Show Name S01E01 1080p HDTV x264-GROUP[rartv]",
      "expect": {
        "release_group": "GROUP"
      }
    },
    {
      "name": "Movie Name 2024 1080p WEBRip DDP5 1 x265 10bit-GalaxyRG265[TGx]",
      "expect": {
        "title": "movie name",
        "year": 2024,
        "audio_codec": "ddp",
        "video_codec": "x265",
        "release_group": "GalaxyRG265"
      }
    },
    {
      "name": "Some Show S01E01 1080p WEB DL DDP5 1 H 265",
      "expect": {
        "source": "webdl",
        "audio_codec": "ddp",
        "video_codec": "x265"
      },
      "note": "fully dot-stripped: WEB DL, DDP5 1 and H 265 all need the pair lookahead"
    },

    {
      "group": "pathological",
      "name": "",
      "expect": {
        "title": "",
        "season": 0
      },
      "pathological": true,
      "note": "empty input must not panic"
    },
    {
      "name": "..........",
      "expect": {
        "title": ""
      },
      "pathological": true,
      "note": "separators only; nothing survives normalisation"
    },
    {
      "name": "1080p",
      "expect": {
        "title": "1080p",
        "resolution": ""
      },
      "pathological": true,
      "note": "with no boundary marker the whole name is the title, so the quality token is never reached. Unmatchable, which is the correct outcome."
    },
    {
      "name": "S01E01",
      "expect": {
        "title": "",
        "season": 1,
        "episodes": [1]
      },
      "pathological": true,
      "note": "numbering with no title. The matcher rejects it on the empty title."
    },
    {
      "name": "[GroupOnly]",
      "expect": {
        "title": "",
        "release_group": "GroupOnly"
      },
      "pathological": true
    },
    {
      "name": "Show.Name.S99E99.1080p.WEB-DL.x264",
      "expect": {
        "season": 99,
        "episodes": [99]
      },
      "pathological": true,
      "note": "absurd but well-formed numbering is accepted; sanity limits belong in the matcher, not the parser"
    },
    {
      "name": "Show.Name.S2024E01.1080p.WEB-DL.x264",
      "expect": {
        "season": 2024,
        "episodes": [1]
      },
      "pathological": true,
      "note": "year-as-season happens with some anthology naming"
    },
    {
      "name": "Movie.Title.2020.2021.1080p.BluRay.x264",
      "expect": {
        "title": "movie title 2020",
        "year": 2021
      },
      "pathological": true,
      "note": "the adjacency rule cannot tell this from 'Blade Runner 2049 2017'. Two touching years are genuinely ambiguous."
    },
    {
      "name": "4K.Ultra.HD.Movie.2020.2160p.BluRay",
      "expect": {
        "title": "4k ultra hd movie",
        "year": 2020,
        "resolution": "2160p"
      },
      "pathological": true,
      "note": "quality words inside the title survive, because everything before the year boundary is the title"
    },
    {
      "name": "Show.Name.Complete.Season.1080p.WEB-DL.x264",
      "expect": {
        "season": 0,
        "is_season_pack": false
      },
      "pathological": true,
      "note": "'Complete Season' with no number yields no season at all. Only 'Complete Series' and 'Complete Collection' set the pack flag."
    },
    {
      "name": "Show - 1080 - Episode Title.mkv",
      "expect": {
        "title": "show",
        "absolute_ep": 1080
      },
      "pathological": true,
      "note": "a dashed number that is not an episode still reads as absolute numbering. Anime numbering and hyphenated titles are not distinguishable from the name alone."
    },
    {
      "name": "01.Track.Name.mp3",
      "expect": {
        "container": ""
      },
      "pathological": true,
      "note": "music files reach the parser only through a misconfigured category; .mp3 is not in the container list so nothing is stripped"
    }
  ]
}
